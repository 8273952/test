  Flag = "PPReachSlider",
  Title = "Proximity Prompt Reach",
  Step = 1,
  Value = {
    Min = 1,
    Max = 10,
    Default = 5,
  },
  Callback = function(value)
    local oldValue = PPReachSliderValue
